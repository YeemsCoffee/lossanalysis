# Nightly pull of yesterday's KDS tickets from Square.
#
# This is installed on every deploy but does nothing until SQUARE_ACCESS_TOKEN
# is set as an environment property — the sync command exits quietly without
# one. Do not set that token until `python -m app.square_sync validate <date>`
# reports a match against a day you already uploaded by CSV.
#
# 09:15 UTC = 02:15 Pacific, comfortably after close and after Square's
# ~15 minute reporting delay has settled.

files:
  "/etc/cron.d/square-sync":
    mode: "000644"
    owner: root
    group: root
    content: |
      SHELL=/bin/bash
      PATH=/usr/local/bin:/usr/bin:/bin
      15 9 * * * webapp /usr/bin/flock -n /tmp/square-sync.lock /opt/elasticbeanstalk/bin/square-sync.sh >> /var/log/square-sync.log 2>&1

  "/opt/elasticbeanstalk/bin/square-sync.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/usr/bin/env bash
      # Load the environment properties EB stores for the app, then sync the
      # last two days — yesterday plus one, so a late-completing ticket or a
      # missed night is picked up on the next run.
      set -euo pipefail
      if [ -f /opt/elasticbeanstalk/deployment/env ]; then
        set -a; . /opt/elasticbeanstalk/deployment/env; set +a
      fi
      cd /var/app/current
      exec /var/app/venv/*/bin/python -m app.square_sync recent --days 2

commands:
  remove_stale_cron:
    command: "rm -f /etc/cron.d/square-sync.bak"
    ignoreErrors: true
