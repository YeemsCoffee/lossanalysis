# Pull KDS tickets from Square every 15 minutes, which is as fresh as the
# Reporting API gets (most cubes lag ~15 minutes).
#
# Two switches guard this, both off by default:
#   SQUARE_ACCESS_TOKEN   — without it the command is a no-op
#   SQUARE_SYNC_ENABLED=1 — without it the command refuses to write
# Set the second only after `python -m app.square_sync validate <date>`
# reports a match, because syncing replaces the days it covers.
#
# The window is two days rather than one on purpose: this box runs UTC while
# the stores run Pacific, so from late afternoon the server's "today" is
# already the store's tomorrow. Square's own local_date puts each ticket on
# the right business day.

files:
  "/etc/cron.d/square-sync":
    mode: "000644"
    owner: root
    group: root
    content: |
      SHELL=/bin/bash
      PATH=/usr/local/bin:/usr/bin:/bin
      */15 * * * * webapp /usr/bin/flock -n /tmp/square-sync.lock /opt/elasticbeanstalk/bin/square-sync.sh >> /var/log/square-sync.log 2>&1

  "/opt/elasticbeanstalk/bin/square-sync.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/usr/bin/env bash
      # Load the environment properties EB stores for the app, then sync
      # yesterday and today so the Pacific business day is always covered.
      set -euo pipefail
      if [ -f /opt/elasticbeanstalk/deployment/env ]; then
        set -a; . /opt/elasticbeanstalk/deployment/env; set +a
      fi
      cd /var/app/current
      exec /var/app/venv/*/bin/python -m app.square_sync recent --days 2 --include-today

  # 96 runs a day would otherwise grow the log unbounded on a small instance.
  "/etc/logrotate.d/square-sync":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/square-sync.log {
        weekly
        rotate 4
        compress
        missingok
        notifempty
        copytruncate
      }

commands:
  remove_stale_cron:
    command: "rm -f /etc/cron.d/square-sync.bak"
    ignoreErrors: true
