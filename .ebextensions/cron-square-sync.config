# Pull KDS tickets from Square every 15 minutes while the stores are open.
# 15 minutes is as fresh as the Reporting API gets (most cubes lag ~that long).
#
# ---------------------------------------------------------------------------
# Why the instance clock is moved to Pacific
# ---------------------------------------------------------------------------
# EB instances run UTC, and the service window in UTC is not fixed:
#
#     06:30 Pacific -> 13:30 UTC in summer, 14:30 UTC in winter
#     17:00 Pacific -> 00:00 UTC in summer, 01:00 UTC in winter
#
# A hardcoded UTC schedule would drift an hour twice a year and would have to
# straddle midnight. Setting the instance to America/Los_Angeles lets the
# schedule below be written in store time, and DST takes care of itself.
#
# Side effect: server-clock timestamps (users.created_at, tickets.uploaded_at,
# password-reset expiry) are now Pacific rather than UTC. None of those feed
# the analysis — ticket times come from Square, not this clock — so the only
# visible change is a one-off discontinuity in those audit columns.
#
# ---------------------------------------------------------------------------
# Guards
# ---------------------------------------------------------------------------
#   SQUARE_ACCESS_TOKEN   - without it the command is a no-op
#   SQUARE_SYNC_ENABLED=1 - without it the command refuses to write
# Set the second only after `python -m app.square_sync validate <date>`
# reports a match, because syncing replaces the days it covers.

commands:
  01_set_timezone:
    command: "timedatectl set-timezone America/Los_Angeles"
    ignoreErrors: true
  02_remove_stale_cron:
    command: "rm -f /etc/cron.d/square-sync.bak"
    ignoreErrors: true
  03_create_sync_log:
    # /var/log is root-owned, so the cron redirect could not create this file
    # and the job produced no output at all — not even the error explaining
    # why it never ran.
    command: "touch /var/log/square-sync.log && chmod 0644 /var/log/square-sync.log"
    ignoreErrors: true

files:
  "/etc/cron.d/square-sync":
    mode: "000644"
    owner: root
    group: root
    content: |
      SHELL=/bin/bash
      PATH=/usr/local/bin:/usr/bin:/bin
      # Times below are America/Los_Angeles (see 01_set_timezone above).
      # Opening half hour.
      30,45 6 * * * root /usr/bin/flock -n /tmp/square-sync.lock /opt/elasticbeanstalk/bin/square-sync.sh >> /var/log/square-sync.log 2>&1
      # Service, 7:00am through 5:45pm. Running past a 5pm close is deliberate:
      # Square's reporting lags ~15 minutes, so the last tickets of the day only
      # appear after it.
      */15 7-17 * * * root /usr/bin/flock -n /tmp/square-sync.lock /opt/elasticbeanstalk/bin/square-sync.sh >> /var/log/square-sync.log 2>&1
      # Overnight reconcile, to catch anything that settled late.
      15 2 * * * root /usr/bin/flock -n /tmp/square-sync.lock /opt/elasticbeanstalk/bin/square-sync.sh >> /var/log/square-sync.log 2>&1

  "/opt/elasticbeanstalk/bin/square-sync.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/usr/bin/env bash
      # Load the environment properties EB stores for the app, then sync
      # yesterday and today. Two days rather than one is cheap insurance: it
      # covers the overnight run, a missed window, and any ticket Square
      # reports late. --catch-up widens that window further whenever a
      # location has fallen behind, so an outage leaves no permanent hole.
      set -uo pipefail

      echo "--- $(date '+%Y-%m-%d %H:%M:%S %Z') starting as $(whoami) ---"

      # EB writes this file 0600 root, so a job running as anyone else gets
      # "Permission denied" here. Say so plainly: under `set -e` this used to
      # abort the script with no explanation of which line failed.
      ENV_FILE=/opt/elasticbeanstalk/deployment/env
      if [ ! -r "$ENV_FILE" ]; then
        echo "FATAL: cannot read $ENV_FILE as $(whoami)."
        echo "       Without it SQUARE_ACCESS_TOKEN and DATABASE_URL are unset"
        echo "       and the sync cannot run. This job must run as root."
        exit 1
      fi
      set -a; . "$ENV_FILE"; set +a

      cd /var/app/current || { echo "FATAL: /var/app/current is missing"; exit 1; }
      PYTHON=$(echo /var/app/venv/*/bin/python)
      if [ ! -x "$PYTHON" ]; then
        echo "FATAL: no interpreter at /var/app/venv/*/bin/python"
        exit 1
      fi
      "$PYTHON" -m app.square_sync recent --days 2 --include-today --catch-up
      echo "--- exit $? ---"

  # Put the log where the console can fetch it. Without these two, the only
  # record of why a sync never ran lives on an instance nobody can reach, and
  # the app cannot report a failure that happened before Python started.
  "/opt/elasticbeanstalk/tasks/taillogs.d/square-sync.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/square-sync.log

  "/opt/elasticbeanstalk/tasks/bundlelogs.d/square-sync.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/square-sync.log

  # ~50 runs a day would otherwise grow the log unbounded on a small instance.
  "/etc/logrotate.d/square-sync":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/square-sync.log {
        weekly
        rotate 4
        compress
        missingok
        notifempty
        copytruncate
      }
