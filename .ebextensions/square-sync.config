# Pull KDS tickets from Square every 15 minutes while the stores are open.
# 15 minutes is as fresh as the Reporting API gets (most cubes lag ~that long).
#
# ---------------------------------------------------------------------------
# Why a systemd timer and not cron
# ---------------------------------------------------------------------------
# This used to be a cron job, and it never ran. Two reasons, either enough:
#
#   1. Amazon Linux 2023, which current Python platforms run, does not
#      install the cron service. A file in /etc/cron.d with no crond to read
#      it fails silently: no error, no log, nothing.
#
#   2. The cron script loaded the environment by sourcing
#      /opt/elasticbeanstalk/deployment/env as shell code. That file is in
#      systemd's format, not the shell's: a database password containing
#      `&` or `$`, or any value with a space, came out empty or ran as a
#      command. An empty DATABASE_URL makes the app fall back to a local
#      SQLite file, so a sync could "succeed" into a file nobody reads.
#
# The web app itself is started by systemd with this same EnvironmentFile,
# so running the sync the same way, as the same user, gives it exactly the
# settings the web app sees — the conditions under which "Sync now" works.
#
# ---------------------------------------------------------------------------
# Why the instance clock is moved to Pacific
# ---------------------------------------------------------------------------
# EB instances run UTC, and the service window in UTC is not fixed:
#
#     06:30 Pacific -> 13:30 UTC in summer, 14:30 UTC in winter
#     17:00 Pacific -> 00:00 UTC in summer, 01:00 UTC in winter
#
# Setting the instance to America/Los_Angeles lets the timer below be written
# in store time, and DST takes care of itself.
#
# Side effect: server-clock timestamps (users.created_at, tickets.uploaded_at,
# password-reset expiry) are Pacific rather than UTC. None of those feed the
# analysis — ticket times come from Square, not this clock.
#
# ---------------------------------------------------------------------------
# Guards
# ---------------------------------------------------------------------------
#   SQUARE_ACCESS_TOKEN   - without it the command is a no-op
#   SQUARE_SYNC_ENABLED=1 - without it the command refuses to write
#
# To run one by hand on the instance:   sudo systemctl start square-sync
# To see when it next fires:            systemctl list-timers square-sync

files:
  "/etc/systemd/system/square-sync.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Pull kitchen tickets from Square
      After=network-online.target
      Wants=network-online.target

      [Service]
      # oneshot: if a sync is still running when the timer fires again,
      # systemd does not start a second one on top of it.
      Type=oneshot
      User=webapp
      # Read by systemd as root before dropping to webapp, so the 0600 root
      # file is no obstacle — and parsed the same way as for the web app.
      EnvironmentFile=/opt/elasticbeanstalk/deployment/env
      WorkingDirectory=/var/app/current
      ExecStart=/bin/bash -c 'exec /opt/elasticbeanstalk/bin/square-sync.sh >> /var/log/square-sync.log 2>&1'
      TimeoutStartSec=10min

  "/etc/systemd/system/square-sync.timer":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Square sync every 15 minutes while the stores are open

      [Timer]
      # Store time (see the timezone note above). Hours and minutes are listed
      # out rather than written as ranges, which older systemd cannot parse.
      #
      # Opening half hour.
      OnCalendar=*-*-* 06:30,45:00
      # Service, 7:00am through 5:45pm. Running past a 5pm close is
      # deliberate: Square's reporting lags ~15 minutes, so the last tickets
      # of the day only appear after it.
      OnCalendar=*-*-* 07,08,09,10,11,12,13,14,15,16,17:00,15,30,45:00
      # Overnight reconcile, to catch anything that settled late.
      OnCalendar=*-*-* 02:15:00
      AccuracySec=1min

      [Install]
      WantedBy=timers.target

  "/opt/elasticbeanstalk/bin/square-sync.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/usr/bin/env bash
      # Run by square-sync.service, which supplies the environment. Do not
      # source the env file here: see "Why a systemd timer" at the top.
      #
      # Syncs yesterday and today. Two days rather than one is cheap
      # insurance: it covers the overnight run, a missed window, and any
      # ticket Square reports late. --catch-up widens that window further
      # whenever a location has fallen behind, so an outage leaves no hole.
      set -uo pipefail

      echo "--- $(date '+%Y-%m-%d %H:%M:%S %Z') starting as $(whoami) ---"

      # Without this the app falls back to a local SQLite file and would
      # happily sync into it, reporting success to a database nobody reads.
      if [ -z "${DATABASE_URL:-}" ]; then
        echo "FATAL: DATABASE_URL is not set. Run this through"
        echo "       'sudo systemctl start square-sync', not directly, so it"
        echo "       gets the same environment as the web app."
        exit 1
      fi

      cd /var/app/current || { echo "FATAL: /var/app/current is missing"; exit 1; }
      PYTHON=$(echo /var/app/venv/*/bin/python)
      if [ ! -x "$PYTHON" ]; then
        echo "FATAL: no interpreter at /var/app/venv/*/bin/python"
        exit 1
      fi
      "$PYTHON" -m app.square_sync recent --days 2 --include-today --catch-up
      status=$?
      echo "--- exit $status ---"
      exit $status

  # Put the log where the console can fetch it: Logs > Request logs. A
  # failure before Python starts never reaches the database, so the app
  # cannot report it; without these the only record is on the instance.
  "/opt/elasticbeanstalk/tasks/taillogs.d/square-sync.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/square-sync.log

  "/opt/elasticbeanstalk/tasks/bundlelogs.d/square-sync.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/square-sync.log

  # ~50 runs a day would otherwise grow the log unbounded on a small instance.
  "/etc/logrotate.d/square-sync":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/square-sync.log {
        weekly
        rotate 4
        compress
        missingok
        notifempty
        copytruncate
      }

commands:
  01_set_timezone:
    command: "timedatectl set-timezone America/Los_Angeles"
    ignoreErrors: true
  02_retire_cron:
    # Earlier deploys installed a cron job. Where cron does exist it would
    # run alongside the timer, and it carries the env-file bug.
    command: "rm -f /etc/cron.d/square-sync /etc/cron.d/square-sync.bak"
    ignoreErrors: true
  03_create_sync_log:
    # The service runs as webapp, which cannot create files in /var/log.
    command: "touch /var/log/square-sync.log && chown webapp /var/log/square-sync.log && chmod 0644 /var/log/square-sync.log"
  04_enable_timer:
    # Restart rather than start, so a changed schedule takes effect on
    # redeploy. Not ignoreErrors: a deploy that silently has no scheduler is
    # exactly the failure this file exists to prevent.
    command: "systemctl daemon-reload && systemctl enable square-sync.timer && systemctl restart square-sync.timer"
