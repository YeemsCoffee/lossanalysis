# -----------------------------------------------------------------------
# Yeems Coffee — Loss Analysis  |  Environment Variables
# -----------------------------------------------------------------------
# Copy this file to .env for local development.
# For production (AWS App Runner), set these in the App Runner console
# under "Environment variables" — never commit real secrets to git.
# -----------------------------------------------------------------------

# Flask secret key — used to sign session cookies.
# Generate a strong one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# Database connection string.
# Leave blank (or unset) to use local SQLite (history.db).
# For AWS RDS PostgreSQL, use:
#   postgresql://username:password@your-rds-endpoint:5432/dbname
DATABASE_URL=

# First admin account — only used on first boot when no users exist.
# After the admin account is created, these values are ignored.
# Remove or clear these after the first deploy if you prefer.
INITIAL_ADMIN_EMAIL=admin@yeemscoffee.com
INITIAL_ADMIN_PASSWORD=change-this-before-first-deploy
