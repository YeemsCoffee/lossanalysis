# -----------------------------------------------------------------------
# Yeems Coffee — Loss Analysis  |  Environment Variables
# -----------------------------------------------------------------------
# Copy this file to .env for local development.
# For production (AWS Elastic Beanstalk), set these in the EB console under
# Configuration > Environment properties — never commit real secrets to git.
# -----------------------------------------------------------------------

# Flask secret key — used to sign session cookies.
# Generate a strong one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# Database connection string.
# Leave blank (or unset) to use local SQLite (history.db).
# For AWS RDS PostgreSQL, use:
#   postgresql://username:password@your-rds-endpoint:5432/dbname
DATABASE_URL=

# First admin account — only used on first boot when no users exist.
# After the admin account is created, these values are ignored.
# Remove or clear these after the first deploy if you prefer.
INITIAL_ADMIN_EMAIL=admin@yeemscoffee.com
INITIAL_ADMIN_PASSWORD=change-this-before-first-deploy

# --- Square Reporting API (optional; enables automatic KDS sync) ---
# Production access token with the REPORTING_READ scope.
# Leave unset to disable syncing entirely — the nightly job becomes a no-op.
SQUARE_ACCESS_TOKEN=

# Map Square's location names onto this app's, if they differ.
# SQUARE_LOCATION_MAP=Yeems Coffee Gardena:Gardena,Yeems KTown:Koreatown

# Restrict to one KDS station type (e.g. expo) if tickets are counted twice.
# SQUARE_STATION_TYPE=expo
